{
  "name": "linkpad-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute linkpad-db --file=./src/schema.sql",
    "db:migrations:apply": "wrangler d1 migrations apply linkpad-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260624.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
