/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/wallpapers/*
  Cache-Control: public, max-age=604800
/favicon.png
  Cache-Control: public, max-age=604800
/logo.png
  Cache-Control: public, max-age=604800
/index.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
